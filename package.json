{
  "name": "agent-valley",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --parallel --filter @agent-valley/api --filter @agent-valley/web dev",
    "build": "bun --filter '@agent-valley/*' build",
    "typecheck": "bun --filter '@agent-valley/*' typecheck",
    "test": "bun --filter '@agent-valley/*' test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
